{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "esengine": ["./.esengine/sdk/index.d.ts"],
      "esengine/ai": ["./.esengine/sdk/ai/index.d.ts"],
      "esengine/wasm": ["./.esengine/sdk/wasm.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
